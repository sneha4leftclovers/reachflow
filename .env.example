# Database (MySQL 8)
DATABASE_URL="mysql://reachflow:reachflowpassword@localhost:3306/reachflow"

# Auth Secrets
JWT_ACCESS_SECRET="dev-access-secret-minimum-32-chars-long-example-key"
JWT_REFRESH_SECRET="dev-refresh-secret-minimum-32-chars-long-example-key"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION_DAYS=7

# Server Configuration
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Web Client Configuration
NEXT_PUBLIC_API_URL="http://localhost:4000/v1"
