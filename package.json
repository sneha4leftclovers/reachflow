{
  "name": "reachflow",
  "private": true,
  "scripts": {
    "dev:api": "pnpm --filter @reachflow/api dev",
    "dev:web": "pnpm --filter @reachflow/web dev",
    "dev": "pnpm --parallel dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @reachflow/api test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "pnpm --filter @reachflow/db generate",
    "db:migrate": "pnpm --filter @reachflow/db migrate",
    "db:push": "pnpm --filter @reachflow/db push",
    "db:seed": "pnpm --filter @reachflow/db seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
